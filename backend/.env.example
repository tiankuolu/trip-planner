# ============ 复制为 .env 后填写 ============
# cp .env.example .env

# ---- LLM（任意 OpenAI 兼容端点）----
LLM_API_KEY=sk-your-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_ID=deepseek-chat
LLM_TIMEOUT=120

# DeepSeek 系模型默认开启思考模式，而思考模式下不支持强制 tool_choice，
# 会让"强制模型调用工具取参数"失效，因此默认关闭；需要时改成 enabled。
LLM_THINKING=disabled

# ---- 服务器 ----
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5300,http://localhost:3000,http://127.0.0.1:5300

# ---- 任务执行方式 ----
# background: API 进程内后台执行（默认，本机不需要额外进程）
# queue:      提交进队列，由 `python -m app.worker` 消费（多进程/多机，可验证故障恢复）
EXECUTION_MODE=background

# 队列 broker：留空用 SQLite（本机零依赖）；填写则用 Redis（多机部署）
# REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_MAX_ATTEMPTS=3

# worker 租约秒数：领了作业多久没完成算它崩了，会被回收重排
WORKER_LEASE_SECONDS=120

# 数据库：默认 SQLite（backend/data/app.db）；换 MySQL 示例：
# DATABASE_URL=mysql+pymysql://user:pass@127.0.0.1:3306/tripplanner
# DATABASE_URL=

# ---- 日志 ----
LOG_LEVEL=INFO

# ---- 高德 Web 服务 Key（必填）----
# 控制台：https://console.amap.com/dev/key/app → 类型选「Web服务」
AMAP_API_KEY=
